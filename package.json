{
  "name": "master-download",
  "productName": "Master Download",
  "version": "0.1.0",
  "description": "Çok bağlantılı, sürdürülebilir indirme yöneticisi; tarayıcı eklentili (Mastertool ailesi)",
  "main": "src/main.js",
  "author": "Mastertool",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "icon": "node scripts/make-icon.js",
    "screenshots": "node scripts/screenshots.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.mastertool.masterdownload",
    "productName": "Master Download",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension/dist",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Master Download",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "ef2",
          "name": "Master Download list",
          "description": "Master Download / IDM export"
        }
      ]
    },
    "nsis": {
      "artifactName": "Master-Download-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Master Download",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": {
      "artifactName": "Master-Download-Portable-${version}.exe"
    }
  }
}
